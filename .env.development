# 只在开发模式中被载入
ENV = 'development'

# 公共基础路径, 详见: https://cn.vitejs.dev/guide/build.html#public-base-path
VITE_BASE_URL = /

# 浏览器同源请求 /api，由 Vite 代理转发到 VITE_API_PROXY_TARGET。
# 生成的接口客户端已自带 /api 前缀，这里的 /api 是第二层，代理 rewrite 会剥掉一层。
VITE_BASE_API_URL = '/api'

# 本地后端（nest-admin）服务根地址。
# 注意：生成的 API 路径本身已带 /api，VITE_BASE_API_URL 又会加一层 /api，
# 代理的 rewrite 会剥掉一层，因此这里必须是根地址、不要带 /api。
# 浏览器: /api/api/auth/login -> 代理: /api/auth/login -> 后端: 7001/api/auth/login
VITE_API_PROXY_TARGET = http://127.0.0.1:7001

VITE_DROP_CONSOLE = false
